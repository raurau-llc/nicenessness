    {
      "topicId": "T267",
      "sha256": "36c4d2abd66d38b36e0d190acac70cb1cd62f57e3cf208daa76cbdf303f5d2ff",
      "validationSha256": "36c4d2abd66d38b36e0d190acac70cb1cd62f57e3cf208daa76cbdf303f5d2ff",
      "validationBasis": "content/revalidation.v21.json; original source record: history-validation fixed-input record; SHA-256 matches unchanged research JSON",
      "facts": [
        {
          "id": "F01",
          "kind": "historical_fact",
          "claim": "Georgia O’Keeffe MuseumはLiving Modern展で、本人が衣服と撮影時のポーズを通じて進歩的で独立した生活像を作ったと位置づける。",
          "sourceIds": [
            "H01"
          ]
        },
        {
          "id": "F02",
          "kind": "historical_fact",
          "claim": "Cleveland Museum of ArtはO’Keeffeが機能的で簡素な服、ローブやケープ、ラップ、ポケットを好んだという展覧会講演を紹介する。",
          "sourceIds": [
            "H02"
          ]
        },
        {
          "id": "F03",
          "kind": "brand_statement",
          "claim": "SS26 GEORGIAは米軍ボートシューズとO’Keeffeの汚れた「コモドール」をイメージした革製ヨットシューズと説明される。",
          "sourceIds": [
            "B01"
          ]
        },
        {
          "id": "F04",
          "kind": "historical_fact",
          "claim": "Georgia O’Keeffe Museum Accessの個体2000.3.689はSperry Top-Siderの白いキャンバススニーカーと記録される。NICENESSが呼ぶ「Commodore」と同一品かは確認できない。",
          "sourceIds": [
            "H03"
          ]
        }
      ],
      "storySha256": "d7d437a40dc33bd4590c02a7304f2197be4c7e13ef1127d09f55d8dd337b3381"
    },
    {
      "topicId": "T276",
      "sha256": "eb74a5b1fd88e319edea54d0f7eb47b82f331dc55bb58958990a5166ee50cfb7",
      "validationSha256": "eb74a5b1fd88e319edea54d0f7eb47b82f331dc55bb58958990a5166ee50cfb7",
      "validationBasis": "content/revalidation.v21.json; original source record: history-validation fixed-input record; SHA-256 matches unchanged research JSON",
      "facts": [
        {
          "id": "F02",
          "kind": "historical_fact",
          "claim": "Paris Muséesの個体2016.1.143.1はPeau d’Ane製、Saint-Tropez、製作circa 1970と登録される一方、写真説明はcirca 1961とする。短い袖なし綿ベストで前合わせとボタンがある。製作年と写真年の記載は整合しない。",
          "sourceIds": [
            "H02"
          ]
        },
        {
