---
import Page from '../../layouts/Page.astro';import Card from '../../components/Card.astro';import {articles} from '../../lib/data';import materials from '../../../content/materials.json';
export function getStaticPaths(){return [...new Set(articles.flatMap(a=>a.products.map(p=>p.id)))].map(id=>({params:{id},props:{id}}))};
const {id}=Astro.props;const related=articles.filter(a=>a.products.some(p=>p.id===id));const a=related[0];const p=a.products.find(p=>p.id===id)!;const primary=a.products[0].id===id;const isProvided=a.sources.some(s=>s.kind==='provided');
---
<Page title={`${p.model} ${p.season} — 歴史とのつながり`} description={`${p.model} ${p.season}が参照した服・技法と、現代の形へ変えたところ。非公式ファンサイトによる紹介。`} breadcrumb={[{name:`${p.model} ${p.season}`,path:`/items/${p.id}/`}]}><article class="reading"><p class="eyebrow">{isProvided?p.model+' / '+p.season:'NICENESS / '+p.season}</p><h1>{p.model}</h1><p class="small">{p.number} {p.season}</p><h2>{primary?a.product_title:'かつての形を、いまのかたちへ。'}</h2>{primary?a.product_paragraphs.map(x=><p>{x}</p>):<><p>{p.retained}</p><h2>いまの使い方に合わせて。</h2><p>{p.changed}</p></>}<p class="boundary">{a.boundary}</p>{p.url?<a class="button" href={p.url} rel="external">公式でアイテムを見る ↗</a>:isProvided?<p class="small">利用者提供の保存資料をもとにした紹介です。資料の発行元・公式性は未確認で、公開URLはありません。</p>:<p class="small">NICENESS公式アーカイブブックをもとに紹介しています。</p>}<p><a href={`/stories/${a.slug}/#sources`}>説明の出典を読む →</a></p>{materials.entries.some(e=>e.productId===id)&&<section><h2>このアイテムに使われる素材</h2><div class="tags">{[...new Set(materials.entries.filter(e=>e.productId===id).flatMap(e=>e.materials))].map(key=><a href={`/materials/?material=${key}`}>{materials.materials.find(m=>m.id===key)!.name} →</a>)}</div></section>}<h2>この服の背景にある話</h2>{related.map(x=><Card article={x}/>)}</article></Page>
