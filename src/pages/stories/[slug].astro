---
import Page from '../../layouts/Page.astro';import Card from '../../components/Card.astro';import {articles,tagPath} from '../../lib/data';import {diagram} from '../../lib/diagrams';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}))};
const {article:a}=Astro.props;
---
<Page title={a.title.replace(/\n/g,'')} description={a.deck+' '+a.place+'・'+a.period+'の背景から、NICENESSによる再解釈を読む。'} article={a} breadcrumb={[{name:a.context,path:`/stories/${a.slug}/`}]}><article class="reading"><header><p class="eyebrow">{a.category}</p><h1>{a.title.split('\n').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h1><p class="deck">{a.deck}</p><div class="metadata">{a.regions.map(r=><a href={`/atlas/?region=${r.id}`}>⌖ {r.name} · {r.role}</a>)}<a href="/eras/">◷ {a.period}</a></div><div class="tags">{a.tags.map(t=><a href={tagPath(t)}># {t}</a>)}</div><p class="small credit">{a.editorialCredit}{a.publishedAt&&<> · <time datetime={a.publishedAt}>{a.publishedAt}</time></>}</p></header><p class="opening">{a.opening}</p>{a.sections.map((part,i)=><section class="chapter"><span class="chapter-number">{String(i+1).padStart(2,'0')}</span><h2>{part.title}</h2>{part.paragraphs.map(p=><p>{p}</p>)}{part.diagram&&<Fragment set:html={diagram(part.diagram)}/>}</section>)}<p class="ending">{a.closing}</p><section class="modern"><p class="eyebrow">そして、いまの服へ。</p><h2>{a.bridge_title}</h2><p>{a.bridge}</p><p class="boundary">{a.boundary}</p>{a.products.map(p=><a class="item-link" href={`/items/${p.id}/`}><small>NICENESS / {p.season}</small><strong>{p.model} →</strong><span>このアイテムのつくりを見る</span></a>)}</section><section class="sources" id="sources"><h2>出典・参考資料</h2>{['history','brand'].map(kind=><section><h3>{kind==='history'?'暮らしと服の歴史':'NICENESSのものづくり'}</h3><ul>{a.sources.filter(s=>s.kind===kind).map(s=><li>{s.url?<a href={s.url} rel="external">{s.title} ↗</a>:<span>{s.title}（アーカイブブック）</span>}<span class="small">{s.publisher}</span></li>)}</ul></section>)}<p class="small">回想は本人の経験として、制作意図はブランドの説明として扱っています。</p></section><aside class="contribute-note"><a href={`/contribute/?article=${a.id}`}>この記事の訂正・追記を提案する →</a></aside></article><h2 class="next-title">次は、どんな暮らしへ。</h2><div class="card-grid">{articles.filter(x=>x.id!==a.id).map(x=><Card article={x}/>)}</div></Page>
