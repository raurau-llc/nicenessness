---
import Page from '../layouts/Page.astro';import {articles,repo} from '../lib/data';
const configured=/^https:\/\/github\.com\/[\w.-]+\/[\w.-]+\/?$/.test(repo);
---
<Page title="訂正・記事を提案する" breadcrumb={[{name:'編集に参加',path:'/contribute/'}]}><article class="reading"><p class="eyebrow">CONTRIBUTE</p><h1>知っていることを、<br/>次の一文へ。</h1><p>気づいた誤り、見つけた資料、服の細部にまつわる話。出典とともに提案をまとめられます。</p><ol class="steps"><li>記事と、変えたい内容を選ぶ。</li><li>出典URLと、どこが根拠になるかを添える。</li><li>編集者が資料を確認し、変更内容を相談する。</li><li>採用した変更は、履歴とともに記事へ反映する。</li></ol>{configured?<p><a class="button" href={`${repo.replace(/\/$/,'')}/issues/new/choose`}>公開リポジトリで提案する ↗</a></p>:<p class="notice">共同編集の受付先は準備中です。いまは提案の下書きを作り、ファイルとして保存できます。この画面からは送信されません。</p>}<form id="proposal"><label>対象の記事<select name="article">{articles.map(a=><option value={a.id}>{a.title.replace(/\n/g,'')}</option>)}<option value="new">新しい記事</option></select></label><label>提案の種類<select name="kind"><option>訂正</option><option>出典の追加</option><option>追記</option><option>新しい記事</option></select></label><label>提案内容<textarea name="change" required rows="5"/></label><label>出典URL・資料名と該当箇所<textarea name="evidence" required rows="4"/></label><p class="small">個人情報や、資料の全文・原写真は記入しないでください。体験談はご自身の経験として区別してください。</p><button class="button" type="submit">提案の下書きを保存</button><p role="status" id="proposal-status"/></form></article></Page>
<script>
const form=document.querySelector<HTMLFormElement>('#proposal')!;const selected=new URLSearchParams(location.search).get('article');if(selected&&[...form.querySelectorAll('select[name="article"] option')].some(o=>(o as HTMLOptionElement).value===selected))(form.elements.namedItem('article') as HTMLSelectElement).value=selected;form.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);const body=`# NICENESSness 編集提案\n\n対象: ${d.get('article')}\n種類: ${d.get('kind')}\n\n## 提案\n${d.get('change')}\n\n## 出典と該当箇所\n${d.get('evidence')}\n`;const url=URL.createObjectURL(new Blob([body],{type:'text/markdown;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='nicenessness-proposal.md';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);document.querySelector('#proposal-status')!.textContent='下書きの保存を開始しました。提案はまだ送信されていません。';});
</script>
