---
import '../styles/global.css';
import {seo,siteDescription} from '../lib/settings';
import {safeJson} from '../lib/seo.mjs';
const {title,description=siteDescription,article=null,noindex=false,breadcrumb=[]}=Astro.props;
const fullTitle=title?`${title} | NICENESSness — 非公式ファンジャーナル`:'NICENESSness — 服の歴史を読む非公式ファンジャーナル';
const canonical=seo.absolute(Astro.url.pathname);
const schema=[{'@context':'https://schema.org','@type':'WebSite',name:'NICENESSness',description:siteDescription,inLanguage:'ja',...(seo.origin?{url:seo.origin+'/'}:{})}];
if(article)schema.push({'@context':'https://schema.org','@type':'Article',headline:article.title.replace(/\n/g,''),description:article.deck,inLanguage:'ja',author:{'@type':'Organization',name:article.editorialCredit},publisher:{'@type':'Organization',name:'NICENESSness'},...(canonical?{mainEntityOfPage:canonical,url:canonical}:{}),...(article.publishedAt?{datePublished:article.publishedAt}:{}),...(article.modifiedAt?{dateModified:article.modifiedAt}:{}),citation:article.sources.filter(s=>s.url).map(s=>s.url)});
if(seo.origin&&breadcrumb.length)schema.push({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'Home',path:'/'},...breadcrumb].map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:seo.absolute(b.path)}))});
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{fullTitle}</title><meta name="description" content={description}/><meta name="robots" content={seo.indexable&&!noindex?'index,follow':'noindex,follow'}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:site_name" content="NICENESSness"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:locale" content="ja_JP"/>{canonical&&<meta property="og:url" content={canonical}/>}<meta name="twitter:card" content="summary"/><meta name="theme-color" content="#98001b"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>{schema.map(s=><script type="application/ld+json" set:html={safeJson(s)}/>)}</head><body>
<a class="skip" href="#main">本文へ進む</a><header class="site-header"><a class="wordmark" href="/" aria-label="NICENESSness ホーム">NICENESS<span>ness</span></a><span class="independent">非公式ファンジャーナル</span><nav aria-label="メインナビゲーション"><a href="/">Journal</a><a href="/atlas/">地図</a><a href="/eras/">年代</a><a href="/search/">検索</a><a href="/contribute/">編集に参加</a></nav></header>
<main id="main">{breadcrumb.length>0&&<nav class="breadcrumbs" aria-label="パンくず"><a href="/">Home</a>{breadcrumb.map(b=><span> / <a href={b.path}>{b.name}</a></span>)}</nav>}<slot/></main>
<footer class="site-footer"><a class="wordmark" href="/">NICENESS<span>ness</span></a><p>服の背景を知る。その先で、いまのものづくりに出会う。</p><p class="small">NICENESSnessは独立した非公式ファンサイトです。NICENESSの公式サイト・運営組織ではなく、提携・公認を示すものではありません。</p><nav aria-label="フッターナビゲーション"><a href="/about/">このサイトについて</a><a href="/contribute/">訂正・記事を提案する</a><a href="https://www.niceness.jp/" rel="external">NICENESS公式サイト ↗</a></nav></footer>
</body></html>
