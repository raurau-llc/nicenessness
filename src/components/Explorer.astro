---
import Card from './Card.astro';import {articles,regions,eras,tags} from '../lib/data';const {mode='search'}=Astro.props;
---
<section class="explorer">
{mode==='atlas'&&<><div class="atlas-map" aria-label="記事の関連地域の概略地図"><svg viewBox="0 0 900 350" aria-hidden="true"><g fill="#ddd" stroke="#fff" stroke-width="2"><path d="M65 66 120 36 217 39 265 71 242 110 193 128 166 158 129 144 99 110Z M166 158 207 184 222 223 210 270 183 321 158 251 158 199Z M377 52 401 32 420 43 414 70 388 83Z M423 88 453 62 488 65 521 41 624 45 706 80 801 85 828 120 784 144 737 135 690 160 665 192 627 146 582 175 554 136 512 137 481 112Z M415 130 457 115 505 145 518 190 488 248 455 266 427 213 409 169Z M709 246 770 227 813 257 793 283 740 289Z"/></g></svg>{[['ca','カナダ',19,25],['us','米国',23,48],['uk','英国',47,24],['jp','日本',86,41],['kashmir','カシミール',68,39]].map(([id,name,x,y])=><a class="map-pin" style={`left:${x}%;top:${y}%`} href={`?region=${id}`} data-region={id}><i/>{name}</a>)}</div><p class="small">記事に登場する国・地域の概略位置です。境界線を示すものではありません。着用地・配達の記録・製織地は、それぞれの記事に表示しています。</p></>}
{mode==='eras'&&<div class="era-strip">{eras.map(e=><a href={`?era=${e.id}`} data-era={e.id}><strong>{e.name}</strong><span>{e.note}</span></a>)}</div>}
<form class="filters" method="get"><label>言葉で探す<input type="search" name="q" placeholder="例：スモック、かすり"/></label><label>地域<select name="region"><option value="">すべて</option>{regions.map(r=><option value={r.id}>{r.name}</option>)}</select></label><label>年代<select name="era"><option value="">すべて</option>{eras.map(r=><option value={r.id}>{r.name}</option>)}</select></label><label>キーワード<select name="tag"><option value="">すべて</option>{tags.map(t=><option>{t}</option>)}</select></label><button type="submit" class="button">絞り込む</button><a class="reset" href={Astro.url.pathname}>条件を解除</a></form>
<noscript><p>絞り込みにはJavaScriptが必要です。下の一覧から全記事を読めます。</p></noscript><p class="result-count" role="status">{articles.length}記事</p><div class="card-grid results">{articles.map(a=><div data-result data-regions={a.regions.map(r=>r.id).join(',')} data-eras={a.eras.join(',')} data-tags={a.tags.join(',')} data-search={[a.title,a.deck,a.opening,a.place,a.period,...a.tags,a.id==='T002'?'かすり カスリ 久留米くるめ':''].join(' ')}><Card article={a}/></div>)}</div><div class="empty" hidden><h2>該当する記事がありません</h2><p>検索する言葉や条件を変えてみてください。</p><a class="reset" href={Astro.url.pathname}>条件を解除する</a></div></section>
<script>
const root=document.querySelector('.explorer');if(root){const form=root.querySelector('form')!;const fields=['q','region','era','tag'];const read=()=>Object.fromEntries(fields.map(k=>[k,(form.elements.namedItem(k) as HTMLInputElement).value]));const normalize=(x:string)=>x.normalize('NFKC').toLocaleLowerCase();function show(){const v=read();let n=0;root!.querySelectorAll<HTMLElement>('[data-result]').forEach(el=>{const match=(!v.region||el.dataset.regions!.split(',').includes(v.region))&&(!v.era||el.dataset.eras!.split(',').includes(v.era))&&(!v.tag||el.dataset.tags!.split(',').includes(v.tag))&&v.q.trim().split(/\s+/).every(word=>normalize(el.dataset.search!).includes(normalize(word)));el.hidden=!match;if(match)n++;});root!.querySelector('.result-count')!.textContent=`${n}記事`; (root!.querySelector('.empty') as HTMLElement).hidden=n!==0;root!.querySelectorAll<HTMLElement>('[data-region],[data-era]').forEach(el=>{const active=el.dataset.region?el.dataset.region===v.region:el.dataset.era===v.era;el.setAttribute('aria-current',active?'true':'false')});}
function fromUrl(){const p=new URLSearchParams(location.search);for(const k of fields)(form.elements.namedItem(k) as HTMLInputElement).value=p.get(k)||'';show();}function update(){const u=new URL(location.href);u.search='';for(const[k,v]of Object.entries(read()))if(v)u.searchParams.set(k,v);history.pushState(null,'',u);show();}
form.addEventListener('submit',e=>{e.preventDefault();update()});root.addEventListener('click',e=>{const a=(e.target as Element).closest<HTMLAnchorElement>('a[data-region],a[data-era],a.reset');if(!a)return;e.preventDefault();if(a.classList.contains('reset'))form.reset();else{const key=a.dataset.region?'region':'era';(form.elements.namedItem(key) as HTMLSelectElement).value=a.dataset[key]!;}update();});window.addEventListener('popstate',fromUrl);fromUrl();}
</script>
