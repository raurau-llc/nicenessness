---
import Card from './Card.astro';import EraTimeline from './EraTimeline.astro';import AtlasMap from './AtlasMap.astro';import {articles,regions,eras,tags} from '../lib/data';const {mode='search'}=Astro.props;
---
<section class="explorer">
{mode==='atlas'&&<AtlasMap/>}
{mode==='eras'&&<EraTimeline/>}
<form class="filters" method="get"><label>言葉で探す<input type="search" name="q" placeholder="例：スモック、かすり"/></label><label>地域<select name="region"><option value="">すべて</option>{regions.map(r=><option value={r.id}>{r.name}</option>)}</select></label><label>年代<select name="era"><option value="">すべて</option>{eras.map(r=><option value={r.id}>{r.name}</option>)}</select></label><label>キーワード<select name="tag"><option value="">すべて</option>{tags.map(t=><option>{t}</option>)}</select></label><button type="submit" class="button">絞り込む</button><a class="reset" href={Astro.url.pathname}>条件を解除</a></form>
<noscript><p>絞り込みにはJavaScriptが必要です。下の一覧から全記事を読めます。</p></noscript><p class="result-count" role="status">{articles.length}記事</p><div class="card-grid results">{articles.map(a=><div data-result data-regions={a.regions.map(r=>r.id).join(',')} data-eras={a.eras.join(',')} data-tags={a.tags.join(',')} data-search={[a.title,a.deck,a.opening,a.place,a.period,...a.tags,a.id==='T002'?'かすり カスリ 久留米くるめ':''].join(' ')}><Card article={a}/></div>)}</div><div class="empty" hidden><h2>該当する記事がありません</h2><p>検索する言葉や条件を変えてみてください。</p><a class="reset" href={Astro.url.pathname}>条件を解除する</a></div></section>
<script>
import positions from '../../content/region-map.json';
import {resolveAtlasArea,matchesAtlasArea} from '../lib/atlas.mjs';
const root=document.querySelector('.explorer');
if(root){
 const form=root.querySelector('form')!;
 const fields=['q','region','era','tag'];
 const isAtlas=!!root.querySelector('.atlas-collection');
 let area='';
 const field=(key:string)=>form.elements.namedItem(key) as HTMLInputElement;
 const read=()=>Object.fromEntries(fields.map(k=>[k,field(k).value]));
 const normalize=(x:string)=>x.normalize('NFKC').toLocaleLowerCase();
 function show(){
  const v=read();let n=0;
  root!.dispatchEvent(new CustomEvent('explorer:filter',{detail:v}));
  root!.querySelectorAll<HTMLElement>('[data-atlas-panel]').forEach(el=>el.hidden=el.dataset.atlasPanel!==(area||'world'));
  root!.querySelectorAll<HTMLElement>('[data-result]').forEach(el=>{
   const ids=el.dataset.regions!.split(',');
   const match=(!v.region||ids.includes(v.region))&&(!isAtlas||matchesAtlasArea(ids,area,positions))&&(!v.era||el.dataset.eras!.split(',').includes(v.era))&&(!v.tag||el.dataset.tags!.split(',').includes(v.tag))&&v.q.trim().split(/\s+/).every(word=>normalize(el.dataset.search!).includes(normalize(word)));
   el.hidden=!match;if(match)n++;
  });
  root!.querySelector('.result-count')!.textContent=`${n}記事`;
  (root!.querySelector('.empty') as HTMLElement).hidden=n!==0;
  root!.querySelectorAll<HTMLElement>('[data-region],[data-era]').forEach(el=>el.setAttribute('aria-current',(el.dataset.region?el.dataset.region===v.region:el.dataset.era===v.era)?'true':'false'));
 }
 function fromUrl(){
  const p=new URLSearchParams(location.search);
  for(const k of fields)field(k).value=p.get(k)||'';
  area=isAtlas?resolveAtlasArea(p.get('area'),field('region').value,positions):'';
  show();
 }
 function update(){
  const u=new URL(location.href);u.search='';
  if(area)u.searchParams.set('area',area);
  for(const[k,v]of Object.entries(read()))if(v)u.searchParams.set(k,v);
  history.pushState(null,'',u);show();
 }
 form.addEventListener('submit',e=>{e.preventDefault();if(isAtlas)area=resolveAtlasArea(area,field('region').value,positions);update()});
 root.addEventListener('click',e=>{
  const a=(e.target as Element).closest<HTMLAnchorElement>('a[data-region],a[data-era],a.reset,a[data-atlas-area],a[data-atlas-world]');
  if(!a||e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;
  e.preventDefault();
  const mapNavigation=a.hasAttribute('data-atlas-world')||!!a.dataset.atlasArea;
  if(a.classList.contains('reset')){form.reset();area='';}
  else if(mapNavigation){field('region').value='';area=a.dataset.atlasArea||'';}
  else{const key=a.dataset.region?'region':'era';field(key).value=a.dataset[key]!;if(isAtlas)area=resolveAtlasArea(area,field('region').value,positions);}
  update();
  if(mapNavigation)root!.querySelector<HTMLElement>('.atlas-panel:not([hidden]) h2')?.focus({preventScroll:true});
 });
 window.addEventListener('popstate',fromUrl);fromUrl();
}
</script>
